# Copy to .env (never commit .env). Every value has a default in src/agent_starter/config.py.

# --- Models: bedrock (default) | anthropic | openai | fake (offline) ------------
LLM_PROVIDER=bedrock
LLM_MODEL=                      # empty = provider default (see providers.py)
EMBEDDINGS_PROVIDER=bedrock     # bedrock (Titan v2) | openai | local (offline)
AWS_REGION=eu-west-1
# AWS credentials come from the standard chain (AWS_PROFILE, SSO, instance role).
# AWS_PROFILE=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- RAG / agent --------------------------------------------------------------
CHUNK_SIZE=400
CHUNK_OVERLAP=60
TOP_K=3
MAX_STEPS=4

# --- Tools --------------------------------------------------------------------
HTTP_API_BASE_URL=https://api.github.com
TICKET_WEBHOOK_URL=             # empty = dry run; in docker-compose: http://n8n:5678/webhook/ticket

# --- API ----------------------------------------------------------------------
N8N_WEBHOOK_TOKEN=              # if set, /webhook/n8n requires header X-Webhook-Token

# --- Observability (Langfuse enabled only if both keys set; uv sync --extra observability)
LOG_LEVEL=INFO
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
